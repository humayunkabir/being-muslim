<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android may copy off this device, for API 30 and below. API 31 and later
  read data_extraction_rules.xml instead; both exclude the same file.

  The tasbih preferences hold the user's own words and their devotional activity.
  The sync marker records the last exchanged tasbih total, which is also
  devotional activity. The reminder preferences hold which prayers the user
  asked to be prompted for.
  The product discloses that devotional activity does not leave the device: the
  counter is local, and carrying it to another device is the optional account's
  job, which syncs the total only (docs/DECISIONS/0003). So these files are
  excluded from platform backup and transfer rather than copied to a cloud
  account (docs/PRODUCT_REQUIREMENTS.md §10).

  WorkManager's database queues the reminder work and carries the prayer name,
  instant and city zone in its input data and tags, so it is excluded too. Losing
  it on restore is harmless: the app reschedules on next launch.

  Appwrite keeps the signed-in session in "myCookie" preferences. It is a
  credential, so it is excluded from backup and transfer; the user signs in on
  the new device instead of carrying the session across.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="being_muslim_tasbih.xml" />
    <exclude domain="sharedpref" path="being_muslim_sync.xml" />
    <exclude domain="sharedpref" path="being_muslim_reminders.xml" />
    <exclude domain="sharedpref" path="myCookie.xml" />
    <exclude domain="sharedpref" path="myCookie_secure.xml" />
    <exclude domain="database" path="androidx.work.workdb" />
    <exclude domain="database" path="androidx.work.workdb-journal" />
    <exclude domain="database" path="androidx.work.workdb-wal" />
    <exclude domain="database" path="androidx.work.workdb-shm" />
</full-backup-content>
